-- Função centralizada para carregar o script principal
local isLoaded = false
local function LoadMainScript()
    if isLoaded then return end
    isLoaded = true
    
    -- Se clicar em skip, enche a barra na hora
    BarFill.Size = UDim2.new(1, 0, 1, 0)
    task.wait(0.2)
    
    oiTubeHubGui:Destroy()
    
    -- Baixa e executa o script modificado para amarelo e sem premium
    local success, scriptContent = pcall(function()
        return game:HttpGet(SCRIPT_URL)
    end)
    
    if success and scriptContent then
        -- Remove checagens de premium se houver no código original substituindo strings
        scriptContent = scriptContent:gsub("isPremium", "true")
        scriptContent = scriptContent:gsub("Premium", "true")
        
        local runSuccess, runErr = pcall(function()
            loadstring(scriptContent)()
        end)
        
        if runSuccess then
            -- Varre a UI gerada para trocar vermelho por amarelo
            task.spawn(function()
                task.wait(0.4)
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui") or CoreGui
                for _, obj in ipairs(playerGui:GetDescendants()) do
                    if obj:IsA("GuiObject") then
                        local col = obj.BackgroundColor3
                        if col.R > 0.8 and col.G < 0.2 and col.B < 0.2 then
                            obj.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
                        end
                        if obj:IsA("TextButton") or obj:IsA("TextLabel") then
                            local tcol = obj.TextColor3
                            if tcol.R > 0.8 and tcol.G < 0.2 and tcol.B < 0.2 then
                                obj.TextColor3 = Color3.fromRGB(255, 215, 0)
                            end
                        end
                    end
                end
            end)
        else
            warn("[oiTube Hub] Erro ao executar script: " .. tostring(runErr))
        end
    else
        warn("[oiTube Hub] Erro ao baixar o script do GitHub.")
    end
end

-- Ação do Botão Skip
SkipButton.MouseButton1Click:Connect(function()
    LoadMainScript()
end)

-- Quando a barra terminar sozinha aos 3 segundos
tweenBar.Completed:Connect(function()
    LoadMainScript()
end)
